+def test_grep_does_not_follow_file_symlink_outside_workspace(tmp_path: Path) -> None:
+    state = make_state(tmp_path)
+    outside = tmp_path.parent / f"{tmp_path.name}-outside.txt"
+    outside.write_text("BOUNDARY_NEEDLE\n", encoding="utf-8")
+    (tmp_path / "outside-link.txt").symlink_to(outside)
+    (tmp_path / "inside.txt").write_text("BOUNDARY_NEEDLE\n", encoding="utf-8")
+
+    result = grep(state, "BOUNDARY_NEEDLE")
+
+    assert result["ok"] is True
+    assert [(match["path"], match["line"]) for match in result["matches"]] == [
+        ("inside.txt", 1),
+    ]
+
+
