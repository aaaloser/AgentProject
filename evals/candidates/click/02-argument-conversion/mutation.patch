+++ b/repro_choice_casefold.py
@@ -0,0 +1,17 @@
+import click
+from click.testing import CliRunner
+
+
+def invoke_unicode_choice(value: str):
+    @click.command()
+    @click.argument("street", type=click.Choice(["Straße"], case_sensitive=False))
+    def cli(street: str) -> None:
+        click.echo(street)
+
+    return CliRunner().invoke(cli, [value])
+
+
+if __name__ == "__main__":
+    result = invoke_unicode_choice("STRASSE")
+    assert result.exit_code == 0, result.output
+    assert result.output == "Straße\n"
