diff --git a/repro_runner_charset.py b/repro_runner_charset.py
new file mode 100644
--- /dev/null
+++ b/repro_runner_charset.py
@@ -0,0 +1,16 @@
+import click
+from click.testing import CliRunner
+
+
+def invoke_latin1_output():
+    @click.command()
+    def cli() -> None:
+        click.echo("café")
+
+    return CliRunner(charset="latin-1").invoke(cli)
+
+
+if __name__ == "__main__":
+    result = invoke_latin1_output()
+    assert result.exit_code == 0, result.output
+    assert result.output == "café\n"
