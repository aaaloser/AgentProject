+++ b/repro_indented_heading.py
@@ -0,0 +1,13 @@
+import click
+
+
+def render_indented_heading() -> str:
+    formatter = click.HelpFormatter(indent_increment=2)
+    formatter.indent()
+    formatter.write_heading("Options")
+    return formatter.getvalue()
+
+
+if __name__ == "__main__":
+    output = render_indented_heading()
+    assert output == "  Options:\n", output
