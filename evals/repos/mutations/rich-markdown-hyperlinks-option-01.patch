diff --git a/repro_markdown_hyperlinks.py b/repro_markdown_hyperlinks.py
new file mode 100644
--- /dev/null
+++ b/repro_markdown_hyperlinks.py
@@ -0,0 +1,16 @@
+from io import StringIO
+
+from rich.console import Console
+from rich.markdown import Markdown
+
+
+def render_disabled_link() -> str:
+    stream = StringIO()
+    console = Console(file=stream, width=80, color_system=None, legacy_windows=False)
+    console.print(Markdown("Read [the docs](https://example.com/docs).", hyperlinks=False))
+    return stream.getvalue()
+
+
+if __name__ == "__main__":
+    output = render_disabled_link()
+    assert "https://example.com/docs" in output, output
