+++ b/repro_double_percent_option.py
@@ -0,0 +1,17 @@
+import click
+from click.testing import CliRunner
+
+
+def invoke_double_percent_option():
+    @click.command()
+    @click.option("%%mode", is_flag=True)
+    def cli(mode: bool) -> None:
+        click.echo(f"mode={mode}")
+
+    return CliRunner().invoke(cli, ["%%mode"])
+
+
+if __name__ == "__main__":
+    result = invoke_double_percent_option()
+    assert result.exit_code == 0, result.output
+    assert result.output == "mode=True\n"
